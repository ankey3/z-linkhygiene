# ==========================================================================
# LinkHygiene — Environment Variables
# Copy this file to .env and fill in values for production
# ==========================================================================

# --- Database (SQLite) ---
# Path must be absolute inside the container. Use the volume mount.
DATABASE_URL=file:/app/data/linkhygiene.db

# --- Server ---
NODE_ENV=production
PORT=3000

# --- Site URL (for sitemap / OG tags / canonical URLs) ---
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# --- Google AdSense (optional — leave empty to disable ads) ---
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXX

# --- CORS Origins (optional — comma-separated, default: same-origin only) ---
# CORS_ORIGINS=https://yourdomain.com
