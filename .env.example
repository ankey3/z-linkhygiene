# ==========================================================================
# LinkHygiene — Environment Variables (Vercel + Neon)
# Set these in your Vercel project dashboard → Settings → Environment Variables
# ==========================================================================

# --- Database (Neon PostgreSQL) ---
# Get these from your Neon project dashboard → Dashboard → Connection Details
#
# DATABASE_URL = Pooled connection (via Neon pooler) — used by app at runtime
#   Format: postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# DIRECT_URL = Direct connection (no pooler) — used by Prisma CLI for migrations
#   Format: postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/linkhygiene?sslmode=require
DIRECT_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/linkhygiene?sslmode=require

# --- Site URL (for sitemap / OG tags / canonical URLs) ---
NEXT_PUBLIC_SITE_URL=https://linkhygiene.com

# --- Google AdSense (optional) ---
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# --- CORS Origins (optional, comma-separated) ---
CORS_ORIGINS=https://linkhygiene.com,https://www.linkhygiene.com
