generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AuditScan {
  id            String   @id @default(cuid())
  url           String
  status        String   @default("pending") // pending, running, completed, failed
  pagesCrawled  Int      @default(0)
  totalLinks    Int      @default(0)
  validLinks    Int      @default(0)
  criticalIssues Int     @default(0)
  warnings      Int      @default(0)
  seoScore      Float    @default(0)
  aeoScore      Float    @default(0)
  geoScore      Float    @default(0)
  aioScore      Float    @default(0)
  sxoScore      Float    @default(0)
  malformedLinks Int     @default(0)
  error404Links  Int     @default(0)
  hashLinks     Int      @default(0)
  // rawHtml was removed — full page HTML is no longer persisted to DB
  // to minimize data-at-rest risk and storage bloat.
  pageTitle     String?
  metaDescription String?
  h1Count       Int      @default(0)
  imageCount    Int      @default(0)
  imagesMissingAlt Int   @default(0)
  hasHttps      Boolean  @default(false)
  hasCanonical  Boolean  @default(false)
  hasViewport   Boolean  @default(false)
  isIndexable   Boolean  @default(false)
  googleScore   Float    @default(0)
  bingScore     Float    @default(0)
  yahooScore    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  issues    AuditIssue[]
  linkData  LinkDatum[]
  keywords  KeywordDensity[]
}

model AuditIssue {
  id          String   @id @default(cuid())
  scanId      String
  scan        AuditScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  errorType   String   // MALFORMED, 404, HASH_LINK
  targetUrl   String
  anchorText  String   @default("")
  sourceUrl   String   @default("")
  whatItIs    String   @default("")
  whyItMatters String  @default("")
  howToFixIt  String   @default("")
  createdAt   DateTime @default(now())
}

model LinkDatum {
  id          String   @id @default(cuid())
  scanId      String
  scan        AuditScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  linkType    String   // internal, external, nofollow, mailto, tel, anchor
  host        String   @default("")
  count       Int      @default(0)
  createdAt   DateTime @default(now())
}

model KeywordDensity {
  id          String   @id @default(cuid())
  scanId      String
  scan        AuditScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  keyword     String
  count       Int      @default(0)
  density     Float    @default(0)
  createdAt   DateTime @default(now())
}