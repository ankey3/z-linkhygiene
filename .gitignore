# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.local
.env.production.local
.env.development.local
.env*.local

# Database files (local SQLite if used for dev)
/db/
*.db
*.db-journal
*.db-wal

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
dev.log
dev.out.log
server.log

# Misc
local-*
.claude
.z-ai-config
test
prompt

# Skills directory
/skills/
